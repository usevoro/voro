{
  "name": "asset-reviewer",
  "productName": "VORO",
  "version": "0.1.0",
  "description": "An offline workspace for reviewing local 3D assets",
  "author": "VORO",
  "license": "MIT",
  "main": "dist/main/index.cjs",
  "type": "module",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "npm run start",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/integration/*.test.ts",
    "test:e2e": "npm run build && tsx --test tests/e2e/*.test.ts",
    "fixtures": "tsx scripts/fixtures.ts",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "benchmark": "tsx scripts/benchmark.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "brand:build": "node scripts/brand.mjs",
    "brand:capture": "npm run build && tsx scripts/capture-brand.ts",
    "schemas:build": "tsx scripts/review-schemas.ts",
    "site:build": "npm --prefix site run build",
    "site:dev": "npm --prefix site run dev",
    "site:test": "npm --prefix site test",
    "site:refresh": "npm --prefix site run refresh",
    "site:capture": "npm run build && tsx scripts/capture-site.ts"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "0.185.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@playwright/test": "^1.58.2",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.183.0",
    "draco3d": "^1.5.7",
    "electron": "44.2.0",
    "esbuild": "^0.28.2",
    "meshoptimizer": "^1.2.0",
    "prettier": "^3.9.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "overrides": {
    "tar": "^7.5.22",
    "tmp": "^0.2.7"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/usevoro/voro.git"
  },
  "bugs": {
    "url": "https://github.com/usevoro/voro/issues"
  },
  "homepage": "https://github.com/usevoro/voro#readme"
}
