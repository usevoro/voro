# Copy to .env.signing (gitignored). No passwords or private keys belong here.
# Developer ID Application identity name, or its 40-character certificate SHA-1.
VORO_MAC_SIGNING_IDENTITY=
# Credentials are stored separately in macOS Keychain using notarytool.
VORO_NOTARY_PROFILE=voro-notary
# Optional future Windows signing: installed certificate thumbprint on Windows.
VORO_WINDOWS_CERT_SHA1=
