{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": { "type": "string", "const": "voro.review-export" },
    "schemaVersion": { "type": "number", "const": 1 },
    "exportedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "project": {
      "type": "object",
      "properties": { "name": { "type": "string" } },
      "required": ["name"],
      "additionalProperties": false
    },
    "scope": { "type": "string", "const": "all_saved_reviews_in_catalog" },
    "assetsWithoutSavedReview": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "format": { "type": "string" },
              "fingerprint": { "type": "string" }
            },
            "required": ["path", "format", "fingerprint"],
            "additionalProperties": false
          },
          "sidecar": { "type": "string" },
          "revision": { "type": "string" },
          "review": {
            "type": "object",
            "properties": {
              "schemaVersion": { "type": "number", "const": 1 },
              "assetId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "assetFile": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "enum": ["unreviewed", "needs_changes", "approved"] },
              "updatedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "comments": {
                "maxItems": 10000,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "text": { "type": "string", "minLength": 1, "maxLength": 20000 },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    },
                    "updatedAt": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    }
                  },
                  "required": ["id", "text", "createdAt", "updatedAt"],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "schemaVersion",
              "assetId",
              "assetFile",
              "status",
              "updatedAt",
              "comments"
            ],
            "additionalProperties": false
          }
        },
        "required": ["asset", "sidecar", "revision", "review"],
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["unreadable_review", "orphan_review", "incomplete_scan"]
          },
          "path": { "type": "string" },
          "message": { "type": "string" }
        },
        "required": ["kind", "message"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "exportedAt",
    "project",
    "scope",
    "assetsWithoutSavedReview",
    "reviews",
    "warnings"
  ],
  "additionalProperties": false,
  "title": "review-export-v1"
}
